# Base URL for API calls. Leave empty to call the same origin
# (in development the Vite dev server proxies /api to the gateway).
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests (the API gateway).
VITE_PROXY_TARGET=http://localhost:8080

# Where short links are served (the backend's security.app.url.base-url).
# Only used to show the prefix next to the custom alias field.
VITE_SHORT_URL_BASE=http://localhost:8080
